# TubeRemix needs no environment variables to run.
# Everything below is optional.

# Public site origin, used for canonical links and share cards (e.g. https://tuberemix.example).
NEXT_PUBLIC_SITE_URL=

# Analytics sink. Unset: events are counted to the server log only.
# "file" writes aggregate-safe events to ./analytics-events.jsonl (self-hosting).
TUBEREMIX_ANALYTICS=

# Local-only features (Sign in with ChatGPT plan usage). Only honoured when the
# server is bound to 127.0.0.1 and requests come from loopback.
TUBEREMIX_LOCAL=
